        <mxCell id="JgQvxjd_zJHxo-MNkVBt-75" value="When new works starts, a feature branch is created from the dev branch" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="960" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JgQvxjd_zJHxo-MNkVBt-76" value="When the developer needs to validate their new code, they push to the feature branch" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="990" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JgQvxjd_zJHxo-MNkVBt-77" value="To enable shared and collaborative development, a PR is created and merged" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="1020" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JgQvxjd_zJHxo-MNkVBt-78" value="When a release is ready to validate, the release/* branch is created from dev branch and a test deploy is triggered" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="1050" width="630" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JgQvxjd_zJHxo-MNkVBt-79" value="If initial QA/Security checks pass, the release candidate is deployed to Staging (prod-like env used for final validation before prod release)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="1080" width="750" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JgQvxjd_zJHxo-MNkVBt-80" value="If staging validation passes, the release branch is merged to the main branch which triggers a production deployment" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="1110" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JgQvxjd_zJHxo-MNkVBt-81" value="For emergency production fixes, a hotfix branch is created from main branch and then merged back when the code fix is implemented" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="1140" width="730" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JgQvxjd_zJHxo-MNkVBt-82" value="If hotfix is deployed to production, the main branch is then synced to the release and dev branches&amp;nbsp;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="710" y="1170" width="550" height="30" as="geometry" />
        </mxCell>
